# do not change it

version: '1.0'
file: start.yml # same as current filename; do not change this
stage: common
actions:
  - name: start_setup
    enable: true
    functions:
      module_file_path: {{ project }}.common.io_utils:setup_project_output_path
      kwargs:
        project_name: {{ project }}
        model_name: {{ model }}
        volumes_root_path: "{% raw %}{{ env.VOLUMES_ROOT_PATH }}{% endraw %}" # change this as per the need
        process_name: {{ model }}_start_setup