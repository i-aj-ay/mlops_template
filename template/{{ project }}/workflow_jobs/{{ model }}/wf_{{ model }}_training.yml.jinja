resources:
  jobs:
    deployment:
      name: mlops_{{ project }}_{{ model }}_training
      tags:
        project_name: "{{ project }}_{{ model }}"

      environments:
        - environment_key: default
          spec:
            client: "3"
            dependencies:
              - "../${var.data_science_project_library}"
              - "../${var.mlops_project_library}"
      
      tasks:
        - task_key: start_setup
          environment_key: default
          spark_python_task:
            python_file: "../scripts/start_setup.py"
            parameters:
              parameters:
              - --runtime_env
              - "${var.run_time_env}"
              - --yml_task
              - "start.yml"
              - --project_name
              - "{{ project }}"
              - --model_name
              - "{{ model }}"
              - --stage_name
              - "common"
              - --task_key
              - '{% raw %}{{task.name}}{% endraw %}' # do not change this
              - --task_run_id
              - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
              - --job_name
              - '{% raw %}{{job.name}}{% endraw %}' # do not change this
              - --job_id
              - '{% raw %}{{job.id}}{% endraw %}' # do not change this
              - --job_run_id
              - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this
        
        - task_key: extract_data
          environment_key: default
          spark_python_task:
            python_file: "../scripts/data_extraction.py"
            parameters:
              parameters:
              - --runtime_env
              - "${var.run_time_env}"
              - --yml_task
              - "data.yml"
              - --project_name
              - "{{ project }}"
              - --model_name
              - "{{ model }}"
              - --stage_name
              - "training"
              - --task_key
              - '{% raw %}{{task.name}}{% endraw %}' # do not change this
              - --task_run_id
              - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
              - --job_name
              - '{% raw %}{{job.name}}{% endraw %}' # do not change this
              - --job_id
              - '{% raw %}{{job.id}}{% endraw %}' # do not change this
              - --job_run_id
              - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this
        
        - task_key: end_setup
            environment_key: default
            spark_python_task:
              python_file: "../scripts/end_setup.py"
              parameters:
                parameters:
                - --runtime_env
                - "${var.run_time_env}"
                - --yml_task
                - "end.yml"
                - --project_name
                - "{{ project }}"
                - --model_name
                - "{{ model }}"
                - --stage_name
                - "common"
                - --task_key
                - '{% raw %}{{task.name}}{% endraw %}' # do not change this
                - --task_run_id
                - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
                - --job_name
                - '{% raw %}{{job.name}}{% endraw %}' # do not change this
                - --job_id
                - '{% raw %}{{job.id}}{% endraw %}' # do not change this
                - --job_run_id
                - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this